# --- secrets / local settings (never commit) ---
.env
.env.*
configs/local.env
.vscode/
.idea/

# --- big or machine-specific ---
external/
.venv/
.cache/
__pycache__/
*.pyc
.pytest_cache/
slurm-*.out
vllm-*.log

# --- run output: raw runs (checkouts, caches, logs) stay local; small summaries go to reports/ ---
results/*
!results/.gitkeep
reports/*/_logs/

# selector replays of the CSC judge: tens of thousands of small files; kept on scratch and on the PC, not in git
# (a git pull on Roihu would re-create them in projappl, which has a 150k-file quota)
# Only the per-bug replay folders (-sel-*) are left out; the small summaries next to them (selection / gate
# .md/.json, judge-job.json) ARE kept in git. Full replays: GitHub release asset (see docs/RESULTS_STORAGE.md).
reports/judge-vllm*/*-sel-*/

# archives made to move results between Roihu and the PC (too big for git; judge-r1.tgz is 168 MB)
*.tgz
