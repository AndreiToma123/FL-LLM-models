+class ApproxEncoding:
+    r"""Fallback tokenizer used when tiktoken cannot load its vocabulary
+    (typically on compute nodes without internet access).
+
+    One "token" is three characters, which over-estimates real token counts for
+    code and therefore errs on the safe side for context-limit checks.
+    """
+    CHUNK = 3
+
+    def encode(self, text, *args, **kwargs):
+        return [text[i:i + self.CHUNK] for i in range(0, len(text), self.CHUNK)]
+
+    def decode(self, tokens, *args, **kwargs):
+        return "".join(tokens)
+
+
+_ENCODINGS = {}
+
+
+def get_encoding(model: ModelType):
+    r"""Returns a tokenizer for `model`; never raises for unknown or LOCAL models.
+
+    Order: tiktoken's encoding for the model, then cl100k_base, then the
+    character-based approximation (with a one-time warning on stderr).
+    """
+    name = model.value_for_tiktoken
+    if name in _ENCODINGS:
+        return _ENCODINGS[name]
+    try:
+        try:
+            encoding = tiktoken.encoding_for_model(name)
+        except KeyError:
+            encoding = tiktoken.get_encoding("cl100k_base")
+    except Exception as exc:  # offline: the BPE file could not be downloaded
+        print(f"[camel.utils] WARNING: tiktoken unavailable ({type(exc).__name__}); "
+              f"using a 3-characters-per-token approximation. Set TIKTOKEN_CACHE_DIR to a "
+              f"pre-warmed cache to avoid this.", file=sys.stderr)
+        encoding = ApproxEncoding()
+    _ENCODINGS[name] = encoding
+    return encoding
+
