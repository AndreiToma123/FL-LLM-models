new file mode 100644
index 0000000..6ff6d02
--- /dev/null
+++ b/camel/local_llm.py
@@ -0,0 +1,207 @@
+"""Open-model support for SoapFL (added by the FL-LLM-models thesis project).
+
+Everything here is standard library only, so it can be imported from anywhere
+in the SoapFL code base without creating import cycles.
+
+Configuration is read from environment variables (all optional unless noted):
+
+  SOAPFL_MODEL_NAME          model name the server expects (REQUIRED for --model LOCAL)
+  SOAPFL_BASE_URL            OpenAI-compatible endpoint, e.g. http://localhost:8000/v1
+                             (falls back to OPENAI_BASE_URL, then the OpenAI default)
+  SOAPFL_UDS                 path of a Unix domain socket the server listens on (vLLM --uds);
+                             base URL then defaults to http://localhost/v1
+  SOAPFL_API_KEY             API key (falls back to OPENAI_API_KEY, then "EMPTY")
+  SOAPFL_CONTEXT_LIMIT       context window of the served model in tokens (default 32768)
+  SOAPFL_TOKEN_MARGIN        safety margin for tokenizer mismatch, 0..0.5 (default 0.10)
+  SOAPFL_MAX_COMPLETION_TOKENS  cap on generated tokens per call (default 4096)
+  SOAPFL_TIMEOUT             per-request timeout in seconds (default 600)
+  SOAPFL_MAX_RETRIES         SDK-level retries on connection errors / 5xx (default 3)
+  SOAPFL_EXTRA_BODY          JSON object passed as extra_body to the server, e.g.
+                             {"chat_template_kwargs": {"enable_thinking": false}}
+  SOAPFL_STRIP_THINK         1 (default) removes <think>...</think> blocks from replies
+  SOAPFL_LENIENT_PARSING     1 = record parse/overflow failures and continue instead of
+                             crashing the whole bug (default 0 = original behaviour)
+  SOAPFL_SEED                if set, seeds the random test-suite/test-case sampling
+  SOAPFL_RUN_DIR             if set, events are appended to <dir>/events.jsonl
+"""
+import json
+import os
+import re
+import threading
+import time
+from typing import Optional, Tuple
+
+
+# --------------------------------------------------------------------------
+# environment helpers
+# --------------------------------------------------------------------------
+
+def env_str(name: str, default: Optional[str] = None) -> Optional[str]:
+    value = os.environ.get(name)
+    return value if value not in (None, "") else default
+
+
+def env_int(name: str, default: int) -> int:
+    value = env_str(name)
+    if value is None:
+        return default
+    try:
+        return int(value)
+    except ValueError:
+        raise ValueError(f"{name} must be an integer, got {value!r}")
+
+
+def env_float(name: str, default: float) -> float:
+    value = env_str(name)
+    if value is None:
+        return default
+    try:
+        return float(value)
+    except ValueError:
+        raise ValueError(f"{name} must be a number, got {value!r}")
+
+
+def lenient() -> bool:
+    return env_str("SOAPFL_LENIENT_PARSING", "0") == "1"
+
+
+def strip_think_enabled() -> bool:
+    return env_str("SOAPFL_STRIP_THINK", "1") != "0"
+
+
+def context_limit() -> int:
+    return env_int("SOAPFL_CONTEXT_LIMIT", 32768)
+
+
+def token_margin() -> float:
+    return min(max(env_float("SOAPFL_TOKEN_MARGIN", 0.10), 0.0), 0.5)
+
+
+def prompt_token_limit() -> int:
+    """Largest prompt (as counted locally) that SoapFL will send."""
+    return int(context_limit() * (1.0 - token_margin()))
+
+
+def max_completion_tokens() -> int:
+    return env_int("SOAPFL_MAX_COMPLETION_TOKENS", 4096)
+
+
+def api_model_name() -> str:
+    name = env_str("SOAPFL_MODEL_NAME")
+    if name is None:
+        raise RuntimeError(
+            "SOAPFL_MODEL_NAME is not set. It must hold the model name the "
+            "OpenAI-compatible server expects when running with --model LOCAL.")
+    return name
+
+
+def base_url() -> Optional[str]:
+    return env_str("SOAPFL_BASE_URL", env_str("OPENAI_BASE_URL"))
+
+
+def unix_socket() -> Optional[str]:
+    """Path of a Unix domain socket to reach the server through (SOAPFL_UDS), or None."""
+    return env_str("SOAPFL_UDS")
+
+
+def api_key() -> str:
+    return env_str("SOAPFL_API_KEY", env_str("OPENAI_API_KEY", "EMPTY"))
+
+
+def request_timeout() -> float:
+    return env_float("SOAPFL_TIMEOUT", 600.0)
+
+
+def max_retries() -> int:
+    return env_int("SOAPFL_MAX_RETRIES", 3)
+
+
+def extra_body() -> Optional[dict]:
+    raw = env_str("SOAPFL_EXTRA_BODY")
+    if raw is None:
+        return None
+    try:
+        value = json.loads(raw)
+    except json.JSONDecodeError as exc:
+        raise ValueError(f"SOAPFL_EXTRA_BODY is not valid JSON: {exc}")
+    if not isinstance(value, dict):
+        raise ValueError("SOAPFL_EXTRA_BODY must be a JSON object")
+    return value
+
+
+# --------------------------------------------------------------------------
+# event log (one JSON object per line, per bug)
+# --------------------------------------------------------------------------
+
+_LOCK = threading.Lock()
+
+
+def log_event(kind: str, **fields) -> None:
+    """Append an event to $SOAPFL_RUN_DIR/events.jsonl. No-op if the variable is unset."""
+    run_dir = env_str("SOAPFL_RUN_DIR")
+    if run_dir is None:
+        return
+    record = {"t": round(time.time(), 3), "type": kind}
+    record.update(fields)
+    try:
+        os.makedirs(run_dir, exist_ok=True)
+        with _LOCK, open(os.path.join(run_dir, "events.jsonl"), "a", encoding="utf-8") as f:
+            f.write(json.dumps(record, ensure_ascii=False, default=str) + "\n")
+    except OSError:
+        # Logging must never break a debugging run.
+        pass
+
+
+# --------------------------------------------------------------------------
+# output post-processing
+# --------------------------------------------------------------------------
+
+def strip_think(text: Optional[str]) -> Tuple[str, int]:
+    """Remove reasoning blocks emitted by "thinking" models.
+
+    Returns (clean_text, number_of_characters_removed). Text without think tags
+    is returned untouched.
+    """
+    if not text:
+        return text or "", 0
+    if "think>" not in text:
+        return text, 0
+    original = len(text)
+    out = re.sub(r"<think>.*?</think>", "", text, flags=re.S)
+    if "</think>" in out:          # template put <think> in the prompt: keep what follows
+        out = out.split("</think>")[-1]
+    elif "<think>" in out:         # unterminated block (generation was cut off)
+        out = out.split("<think>")[0]
+    out = out.strip()
+    return out, original - len(out)
+
+
+_STRICT_SCORE = re.compile(r"#(\d+)#")
+_LENIENT_SCORES = (
+    re.compile(r"#\s*(\d+)\s*#"),
+    re.compile(r"(?i)\bscore\b\W{0,12}(\d+)"),
+    re.compile(r"\b(\d+)\s*/\s*10\b"),
+)
+
+
+def parse_score(text: str) -> Optional[int]:
+    """Extract the 1-10 suspiciousness score from a MethodReview answer.
+
+    Strict mode reproduces SoapFL: the first ``#N#`` in the text, no range check.
+    Lenient mode additionally accepts ``# N #``, ``Score: N`` and ``N/10`` and
+    only returns values in 0..10.
+    """
+    strict = _STRICT_SCORE.findall(text)
+    if not lenient():
+        return int(strict[0]) if strict else None
+    candidates = []
+    if strict:
+        candidates.append(int(strict[0]))
+    for pattern in _LENIENT_SCORES:
+        match = pattern.search(text)
+        if match:
+            candidates.append(int(match.group(1)))
+    for value in candidates:
+        if 0 <= value <= 10:
+            return value
+    return None
