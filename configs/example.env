# Copy to configs/local.env, edit, then:  source configs/local.env
export SOAPFL_BASE_URL="http://localhost:8000/v1"
export SOAPFL_MODEL_NAME="Qwen/Qwen2.5-Coder-7B-Instruct"   # must equal vLLM's served model name
export SOAPFL_API_KEY="EMPTY"
export SOAPFL_CONTEXT_LIMIT=32768          # must be <= vLLM --max-model-len
export SOAPFL_MAX_COMPLETION_TOKENS=4096
export SOAPFL_TOKEN_MARGIN=0.10            # safety margin for tokenizer mismatch
# For Qwen3 with thinking switched off (optional):
# export SOAPFL_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

export DEFECTS4J_HOME="$PWD/external/defects4j"
export PATH="$DEFECTS4J_HOME/framework/bin:$PATH"
# export JAVA_HOME=/path/to/java8
export TIKTOKEN_CACHE_DIR="$PWD/.cache/tiktoken"
export HF_HOME="$PWD/.cache/hf"            # put model weights on fast scratch storage on CSC
