# Copy this file to  .env  in the repo root (docker compose reads it), then edit.
# Ollama runs on your computer; the container reaches it via host.docker.internal.
SOAPFL_BASE_URL=http://host.docker.internal:11434/v1
SOAPFL_API_KEY=ollama
# Name of the model variant you create with configs/ollama/Modelfile.* (see README), as shown by `ollama list`
SOAPFL_MODEL_NAME=soapfl-qwen:latest
# MUST NOT exceed the num_ctx in the Modelfile. Ollama silently truncates longer prompts.
SOAPFL_CONTEXT_LIMIT=16384
SOAPFL_MAX_COMPLETION_TOKENS=2048
SOAPFL_TOKEN_MARGIN=0.10
