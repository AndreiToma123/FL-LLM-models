# Copy this file to  .env  in the repo root (docker compose reads it). That is all you need to set:
# Ollama runs on your computer; the container reaches it via host.docker.internal.
SOAPFL_BASE_URL=http://host.docker.internal:11434/v1
SOAPFL_API_KEY=ollama

# You do NOT set the model name or context size here any more. `.\run-experiment.ps1 <model>` reads
# configs\models.json, creates an Ollama variant with the right context size, and sets
# SOAPFL_MODEL_NAME / SOAPFL_CONTEXT_LIMIT / SOAPFL_MAX_COMPLETION_TOKENS / SOAPFL_EXTRA_BODY for that run.
